<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><title>Add Product</title><style>
  body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 25px; }
  .box { max-width: 760px; margin: 0 auto; background: #fff; padding: 22px; border: 1px solid #ccc; }
  .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { border: 1px solid #ddd; padding: 9px; text-align: left; }
  th { background: #333; color: #fff; }
  .btn { padding: 6px 12px; text-decoration: none; border: none; cursor: pointer; font-size: 13px; display: inline-block; }
  .add { background: #2e7d32; color: #fff; }
  .edit { background: #ed6c02; color: #fff; }
  .del { background: #d32f2f; color: #fff; }
  .back { background: #666; color: #fff; }
  form.form-col { display: flex; flex-direction: column; gap: 10px; max-width: 420px; }
  input, textarea { padding: 8px; border: 1px solid #bbb; font-family: inherit; }
</style></head>
<body>
  <div class="box">
    <h2>Add New Product</h2>
    <form class="form-col" action="/products" method="POST">
      <input type="text" name="name" placeholder="Product Name" required>
      <input type="number" name="price" placeholder="Price" required>
      <textarea name="description" rows="3" placeholder="Description" required></textarea>
      <div>
        <button class="btn add" type="submit">Save</button>
        <a class="btn back" href="/products">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
